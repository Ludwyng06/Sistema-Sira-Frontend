# Desarrollo local: sin BACKEND_URL se conserva la conexión directa al backend.
BACKEND_URL=
NEXT_PUBLIC_API_URL=http://localhost:3001/api
API_URL_INTERNA=http://localhost:3001/api

# Vercel (reemplazar el dominio de ejemplo por el servicio de Cloud Run):
# BACKEND_URL=https://sira-backend.example.run.app
# NEXT_PUBLIC_API_URL=/api
# API_URL_INTERNA=https://sira-backend.example.run.app/api

# Versión vigente de la política de datos (debe coincidir con version_politica_datos del backend)
NEXT_PUBLIC_VERSION_POLITICA=2026-10
